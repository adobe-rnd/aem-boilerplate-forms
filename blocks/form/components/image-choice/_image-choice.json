{
    "definitions": [
        {
            "title": "Image choice",
            "id": "image-choice",
            "plugins": {
                "xwalk": {
                    "page": {
                        "resourceType": "core/fd/components/form/checkboxgroup/v1/checkboxgroup",
                        "template": {
                            "jcr:title": "Image choice",
                            "fieldType": "checkbox-group",
                            "enum": [
                                "0",
                                "1"
                            ],
                            "enumNames": [
                                "Option 1",
                                "Option 2"
                            ],
                            "orientation": "horizontal",
                            "type": "string[]",
                            "fd:viewType": "image-choice"
                        }
                    }
                }
            }
        }
    ],
    "models": [
        {
            "id": "image-choice",
            "fields": [
                {
                    "component": "tab",
                    "label": "Basic",
                    "name": "basic"
                },
                {
                    "...": "../../models/form-common/_basic-select-fields.json#/fields"
                },
                {
                    "component": "select",
                    "label": "Save value as",
                    "name": "type",
                    "valueType": "string",
                    "value": "string[]",
                    "options": [
                        {
                            "name": "String",
                            "value": "string[]"
                        },
                        {
                            "name": "Boolean",
                            "value": "boolean[]"
                        },
                        {
                            "name": "Number",
                            "value": "number[]"
                        }
                    ]
                },
                {
                    "component": "radio-group",
                    "label": "Selection mode",
                    "name": "selectionMode",
                    "valueType": "string",
                    "value": "single",
                    "options": [
                        {
                            "name": "Single",
                            "value": "single"
                        },
                        {
                            "name": "Multiple",
                            "value": "multi"
                        }
                    ]
                },
                {
                    "component": "text",
                    "name": "imageUrls",
                    "label": "Option images (URLs)",
                    "valueType": "string",
                    "multi": true,
                    "description": "One image URL per option, in the same order as the options."
                },
                {
                    "component": "number",
                    "name": "columns",
                    "label": "Columns",
                    "valueType": "number",
                    "description": "Number of images per row. Leave empty to fit automatically."
                },
                {
                    "component": "boolean",
                    "name": "showLabels",
                    "label": "Show option labels",
                    "valueType": "boolean",
                    "value": false,
                    "description": "Show the display value below each image. It is always used as the image alt text."
                },
                {
                    "component": "tab",
                    "label": "Validation",
                    "name": "validation"
                },
                {
                    "...": "../../models/form-common/_basic-validation-fields.json#/fields"
                },
                {
                    "...": "../../models/form-common/_help-container.json#/fields"
                }
            ]
        }
    ]
}